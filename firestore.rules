rules_version = '2';
// Access rules for the member registration site.
//  - Members (Google sign-in) can create, read and correct only their own application and photo.
//  - Only staff listed in /admins/{uid} can read or change anything else.
//  - /admins can only be edited from the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function appPath(uid) { return /databases/$(database)/documents/applications/$(uid); }
    function appEditable(uid) {
      return !exists(appPath(uid)) || get(appPath(uid)).data.status in ['submitted', 'returned'];
    }
    function validProfile(p) {
      return p is map && p.size() <= 60
        && p.name is string && p.name.size() > 0 && p.name.size() <= 100
        && p.birth is string && p.birth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && p.region is string && p.region.size() > 0 && p.region.size() <= 80
        && p.email is string && p.email.size() <= 254;
    }
    function validSubmission(d) {
      return d.status == 'submitted' && d.consent == true && d.hasPhoto is bool
        && d.lang in ['ja', 'ko'] && d.updatedAt == request.time && validProfile(d.profile);
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /applications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['gender', 'profile', 'status', 'consent', 'lang', 'hasPhoto', 'createdAt', 'updatedAt'])
        && request.resource.data.gender in ['female', 'male']
        && request.resource.data.createdAt == request.time
        && validSubmission(request.resource.data);
      allow update: if isAdmin() || (isOwner(uid)
        && resource.data.status in ['submitted', 'returned']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'status', 'consent', 'lang', 'hasPhoto', 'updatedAt'])
        && validSubmission(request.resource.data));
      allow delete: if isAdmin();
    }

    match /photos/{key} {
      allow read: if isOwner(key) || isAdmin();
      allow create, update: if isAdmin() || (isOwner(key) && appEditable(key)
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 750000
        && request.resource.data.updatedAt == request.time);
      allow delete: if isAdmin() || (isOwner(key) && appEditable(key));
    }

    match /members/{memberId} {
      allow read, write: if isAdmin();
      match /records/{recordId} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
