rules_version = '2';
// Access rules for the member registration site.
//  - Members (Google / Microsoft / e-mail sign-in) can create, read and correct only their own application and photo.
//  - Only staff listed in /admins/{uid} can read or change anything else.
//  - /admins can only be edited from the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // E-mail + password accounts must confirm their address first (Google / Microsoft are checked by the provider).
    function confirmed() {
      return request.auth.token.firebase.sign_in_provider != 'password' || request.auth.token.email_verified == true;
    }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function appPath(uid) { return /databases/$(database)/documents/applications/$(uid); }
    function appEditable(uid) {
      return !exists(appPath(uid)) || get(appPath(uid)).data.status in ['submitted', 'returned'];
    }
    function validProfile(p) {
      return p is map && p.size() <= 60
        && p.name is string && p.name.size() > 0 && p.name.size() <= 100
        && p.birth is string && p.birth.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && p.region is string && p.region.size() > 0 && p.region.size() <= 80
        && p.email is string && p.email.size() <= 254;
    }
    function validSubmission(d) {
      return d.status == 'submitted' && d.consent == true && d.hasPhoto is bool
        && d.lang in ['ja', 'ko'] && d.updatedAt == request.time && validProfile(d.profile);
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /applications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && confirmed()
        && request.resource.data.keys().hasOnly(['gender', 'profile', 'status', 'consent', 'lang', 'hasPhoto', 'createdAt', 'updatedAt'])
        && request.resource.data.gender in ['female', 'male']
        && request.resource.data.createdAt == request.time
        && validSubmission(request.resource.data);
      allow update: if isAdmin() || (isOwner(uid) && confirmed()
        && resource.data.status in ['submitted', 'returned']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile', 'status', 'consent', 'lang', 'hasPhoto', 'updatedAt'])
        && validSubmission(request.resource.data));
      allow delete: if isAdmin();
    }

    match /photos/{key} {
      allow read: if isOwner(key) || isAdmin();
      allow create, update: if isAdmin() || (isOwner(key) && confirmed() && appEditable(key)
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 750000
        && request.resource.data.updatedAt == request.time);
      allow delete: if isAdmin() || (isOwner(key) && appEditable(key));
    }

    match /members/{memberId} {
      allow read, write: if isAdmin();
      match /records/{recordId} {
        allow read, write: if isAdmin();
      }
      match /activity/{activityId} {
        allow read, write: if isAdmin();
      }
    }

    // Suspended accounts (applications/{uid}.suspended, set only by staff) cannot send or answer anything.
    function activeAccount() {
      return signedIn() && exists(appPath(request.auth.uid))
        && get(appPath(request.auth.uid)).data.get('suspended', false) != true;
    }

    // 1:1 inquiries, consultation bookings and reports from members to staff.
    match /inquiries/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if activeAccount()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'subject', 'body', 'booking', 'introId', 'status', 'memberSeen', 'name', 'gender', 'lang', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['question', 'booking', 'report']
        && request.resource.data.status == 'new'
        && request.resource.data.memberSeen == true
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 200
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.gender in ['female', 'male']
        && request.resource.data.lang in ['ja', 'ko']
        && request.resource.data.get('booking', {}) is map && request.resource.data.get('booking', {}).size() <= 3
        && request.resource.data.get('introId', '') is string && request.resource.data.get('introId', '').size() <= 40
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      // Members may only mark a staff reply as read.
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberSeen'])
        && request.resource.data.memberSeen == true);
      allow delete: if isAdmin();
    }

    // Introductions made by staff. Each member may answer only their own side, once, while the intro is open.
    function respOk(before, after) { return after == before || (before == 'pending' && after in ['yes', 'no']); }
    function sideUpdate(s) {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return resource.data['uid' + s] == request.auth.uid
        && changed.hasOnly(['resp' + s, 'resp' + s + 'At', 'seen' + s])
        && respOk(resource.data['resp' + s], d['resp' + s])
        && (!changed.hasAny(['resp' + s]) || d['resp' + s + 'At'] == request.time)
        && d['seen' + s] is bool;
    }
    match /intros/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.uids);
      allow update: if isAdmin() || (activeAccount() && resource.data.status == 'open' && (sideUpdate('A') || sideUpdate('B')));
      allow create, delete: if isAdmin();
    }

    // What each side is shown about the partner (no name or contact details). Written by staff only.
    match /introCards/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.viewerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
